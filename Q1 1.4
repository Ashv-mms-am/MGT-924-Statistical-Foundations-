# --- 5. Create and Display Scatterplots for Each Dataset ---
# This section visualizes the data, which is crucial for interpretation.
# We use ggplot2 to create a scatterplot for each dataset and add the OLS line.
cat("\n\n--- Generating Scatterplots for Each Dataset ---\n")

anscombe_plots <- ggplot(anscombe_data, aes(x = x, y = y)) +
  # Add the points to create the scatterplot.
  geom_point(size = 3, color = "steelblue") +
  # Add the OLS regression line (linear model -> lm) without the confidence interval.
  geom_smooth(method = "lm", se = FALSE, color = "firebrick") +
  # Create a separate plot panel for each unique value in the 'dataset' column.
  facet_wrap(~ dataset, ncol = 2) +
  # Add informative labels and a title.
  labs(
    title = "Relationship between X and Y across Four Datasets",
    subtitle = "Anscombe's Quartet with OLS Regression Lines",
    x = "X Value",
    y = "Y Value"
  ) +
  # Use a clean, minimal theme for the plot.
  theme_minimal()

# Print the generated plot to the plot viewer.
print(anscombe_plots)
