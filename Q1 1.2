# Title: Statistical Analysis of Anscombe's Quartet
# Author: Gemini
# Date: 06/09/2024
# Description: This script reads the 'ans.csv' file, groups the data by the 'dataset'
#              column, and computes several summary statistics and OLS regression
#              estimates for each group using the lm() function.

# --- 1. Load Necessary Libraries ---
# We use the 'dplyr' package from the tidyverse for its powerful and intuitive
# data manipulation verbs like group_by() and summarise().
# If you don't have it installed, run: install.packages("dplyr")
library(dplyr)
# We use 'readr' for efficiently reading the CSV file.
# If you don't have it installed, run: install.packages("readr")
library(readr)


# --- 2. Load the Data ---
# Read the provided CSV file into a data frame called 'anscombe_data'.
# It's good practice to inspect the first few rows to ensure it loaded correctly.
anscombe_data <- read_csv("ans.csv")
print("Data successfully loaded. Here are the first few rows:")
print(head(anscombe_data))


# --- 3. Compute Statistics and OLS Estimates for Each Dataset ---
# This is the core of the analysis. We use a chain of operations from dplyr.
summary_statistics <- anscombe_data %>%
  # (a) Group the data frame by the 'dataset' column. All subsequent operations
  #     will be performed separately on each unique dataset (I, II, III, IV).
  group_by(dataset) %>%
  # (b) Summarise each group by calculating the required statistics.
  summarise(
    # (1.1.1) The mean of x
    mean_x = mean(x),
    # (1.1.2) The mean of y
    mean_y = mean(y),
    # (1.1.3) The sample variance of x (n-1 denominator)
    variance_x = var(x),
    # (1.1.4) The sample variance of y (n-1 denominator)
    variance_y = var(y),
    # (1.1.5) The Pearson correlation between x and y
    correlation_xy = cor(x, y),
    # (1.1.6) The R-squared value from a simple linear regression of y on x.
    # For a simple linear regression, R^2 is the square of the correlation coefficient.
    # This fulfills the requirement of using only the previously calculated statistics.
    r_squared = correlation_xy^2,
    # OLS intercept estimate (beta_0) using the lm() function. The `coef()` function
    # extracts a named vector of coefficients, and we take the first element.
    # The `data = .` argument tells lm() to use the current group's data.
    ols_intercept = coef(lm(y ~ x, data = .))[1],
    # OLS slope estimate (beta_1) using the lm() function. We take the second element
    # from the vector of coefficients.
    ols_slope = coef(lm(y ~ x, data = .))[2]
  )

# --- 4. Display the Results ---
# Print the final summary table to the console.
cat("\n--- Computed Summary Statistics and OLS Estimates for Each Dataset ---\n")
print(summary_statistics)
